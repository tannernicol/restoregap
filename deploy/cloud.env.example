# Restore Gap Cloud configuration (see docs/CLOUD.md "Run it yourself").
# Copy to deploy/cloud.env; that file is gitignored.

# Public URL (no trailing slash). Used in magic-link emails and share links.
RESTOREGAP_CLOUD_BASE_URL=https://cloud.example.com

# Magic-link email. Leave unset to print login links to the log (dev / single operator).
# RESTOREGAP_CLOUD_SMTP_URL=smtp://user:password@smtp.example.com:587?from=cloud@example.com

# Stripe. Leave all unset to run in self-hosted mode: one unlimited workspace, billing pages hidden.
# RESTOREGAP_CLOUD_STRIPE_SECRET=sk_live_...
# RESTOREGAP_CLOUD_STRIPE_WEBHOOK_SECRET=whsec_...
# RESTOREGAP_CLOUD_PRICE_SOLO=price_...
# RESTOREGAP_CLOUD_PRICE_TEAM=price_...
# RESTOREGAP_CLOUD_PRICE_FLEET=price_...

# Refuse new workspaces (existing logins keep working).
# RESTOREGAP_CLOUD_ALLOW_SIGNUP=false
